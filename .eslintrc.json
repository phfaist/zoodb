{
    "ignorePatterns": [
        "src/zooflm/_flm-js/*.js",
        "flm-js-src/flm-js/**/*.js",
        "src/citationmanager/_wasm/"
    ],
    "env": {
        "browser": true,
        "es2021": true
    },
    "extends": "eslint:recommended",
    "parserOptions": {
        "ecmaVersion": "latest",
        "sourceType": "module"
    },
    "overrides": [
        {
            "files": [
                "tools/*.mjs"
            ],
            "env": {
                "node": true
            }
        }
    ]
}
