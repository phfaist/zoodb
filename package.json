{
    "name": "@phfaist/zoodb",
    "type": "module",
    "version": "0.2.0",
    "author": "Philippe Faist",
    "license": "MIT",
    "packageManager": "yarn@4.6.0",
    "dependencies": {
        "@apidevtools/json-schema-ref-parser": "^11.7.3",
        "base32-encode": "^2.0.0",
        "citeproc": "^2.4.62",
        "debug": "^4.4.0",
        "escape-html": "^1.0.3",
        "exif-parser": "^0.1.12",
        "glob": "^11.0.0",
        "hash.js": "^1.1.7",
        "js-yaml": "^4.1.0",
        "jsonschema": "^1.4.1",
        "lodash": "^4.17.21",
        "sax": "^1.4.1",
        "stream-parser": "^0.3.1",
        "url": "^0.11.4"
    },
    "main": "./src/index.js",
    "bin": {
        "zoodb-migrate-citations-cache": "./tools/migrate_citations_cache.mjs",
        "zoodb-extend-citations-ttl": "./tools/extend_citations_ttl.mjs"
    },
    "engines": {
        "node": ">=18"
    },
    "devDependencies": {
        "eslint": "^9.17.0",
        "mocha": "11.0.2"
    },
    "scripts": {
        "test": "mocha",
        "test-debug": "DEBUG=\"zoodb*,mocha*\" mocha",
        "lint": "ESLINT_USE_FLAT_CONFIG=false eslint 'src/**/*.js' 'tools/*.mjs'",
        "build:wasm": "node tools/build_wasm.mjs"
    },
    "exports": {
        ".": "./src/index.js",
        "./citationmanager": "./src/citationmanager/index.js",
        "./citationmanager/wasm": "./src/citationmanager/_load_wasm.js",
        "./citationmanager/source/*": "./src/citationmanager/source/*.js",
        "./schemaloader": "./src/schemaloader.js",
        "./dbdataloader/*": "./src/dbdataloader/*.js",
        "./dbprocessor/*": "./src/dbprocessor/*.js",
        "./resourcecollector": "./src/resourcecollector/index.js",
        "./resourcecollector/retriever/*": "./src/resourcecollector/retriever/*.js",
        "./resourcecollector/processor/*": "./src/resourcecollector/processor/*.js",
        "./zooflm": "./src/zooflm/index.js",
        "./zooflm/citationcompiler": "./src/zooflm/citationcompiler.js",
        "./zooflm/scanner": "./src/zooflm/scanner.js",
        "./util": "./src/util/index.js",
        "./util/*": "./src/util/*.js",
        "./std": "./src/std/index.js",
        "./std/*": "./src/std/*.js",
        "./flm-js/*": "./flm-js-src/flm-js/*.js"
    }
}
